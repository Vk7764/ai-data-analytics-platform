# ============================================================
# AI Data Analytics Platform: environment variables
# Copy to .env and fill in. NEVER commit the real .env file.
# ============================================================

# ---------- Core / production safety ----------
# Set to "production" on live hosts. Then APP_SECRET_KEY and APP_CORS_ORIGINS become mandatory,
# and ALLOW_UNSAFE_LOCAL_EXEC is refused.
ENV=production
# Long random string (32+ chars), identical for every container/worker. Generate: python -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET_KEY=
# Optional: refuse to start without APP_SECRET_KEY (already implied by ENV=production)
REQUIRE_APP_SECRET_KEY=1
# Comma-separated exact frontend URL(s), no trailing slash. Example: https://your-app.vercel.app
APP_CORS_ORIGINS=
# Public frontend URL used inside emailed links (verify email, reset password, delete account)
FRONTEND_URL=
# Secret for POST /api/admin/set-plan (header X-Admin-Key). Leave empty to disable the endpoint.
ADMIN_SECRET_KEY=
# Port the server listens on (Render sets this itself; Hugging Face Spaces: 7860)
# PORT=8000

# ---------- Email ----------
# 1 = users must verify email before using AI features. Set 0 if no email provider works on your host.
REQUIRE_EMAIL_VERIFICATION=1
# HTTPS email APIs (work on free hosts that block SMTP port 587). Set ONE of them.
RESEND_API_KEY=
BREVO_API_KEY=
# Sender address (must be verified with Resend/Brevo)
EMAIL_FROM=
# EMAIL_FROM_NAME=AI Data Analytics
# Gmail SMTP fallback (needs a Google App Password; port 587 is blocked on many free hosts)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Show technical email errors to users (testing only; remove before launch)
# SHOW_EMAIL_ERRORS=1

# ---------- AI providers (set at least one) ----------
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
GROQ_API_KEY=
# GROQ_MODEL_PRIMARY=
# GROQ_MODEL_FALLBACK=
GEMINI_API_KEY=
# GEMINI_MODEL=
MISTRAL_API_KEY=
# MISTRAL_MODEL=
HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODEL=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Local Ollama is skipped on cloud hosts unless enabled explicitly
# OLLAMA_ENABLED=1
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=
# Max seconds one AI request may spend across all providers
LLM_TOTAL_BUDGET_SECONDS=40
# Daily AI request limits per user
FREE_DAILY_AI_LIMIT=30
PREMIUM_DAILY_AI_LIMIT=300

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: upgrades users even if their browser closes mid-checkout.
# Webhook URL: https://<backend-url>/api/payments/webhook (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
PREMIUM_PRICE_INR=499

# ---------- Limits ----------
# Upload size cap in MB (100 is safe for 512 MB RAM hosts)
MAX_UPLOAD_SIZE_MB=100
# MAX_DATASETS_PER_USER=50
# MAX_DATASET_CELLS=50000000
# MAX_USER_CELLS=100000000

# ---------- Rate limiting / proxy ----------
# 1 = share rate-limit counters between workers through SQLite
RATE_LIMIT_SHARED=0
# Number of reverse proxies in front of the app (Render/HF = 1; Cloudflare + host = 2)
TRUSTED_PROXY_HOPS=1

# ---------- Code sandbox (local Docker Desktop only) ----------
# DEVELOPMENT ONLY. Ignored when ENV=production. Never enable on a hosted server.
# ALLOW_UNSAFE_LOCAL_EXEC=1
# SANDBOX_MAX_CONCURRENT=4
# SANDBOX_QUEUE_WAIT_SECONDS=15

# ---------- Reports ----------
# Path to a .ttf font that covers non-Latin text (for example Hindi) in PDF reports
# REPORT_UNICODE_FONT=

# ---------- Monitoring ----------
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production